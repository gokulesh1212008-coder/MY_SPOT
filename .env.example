# ===== MYSPOT environment variables =====
# Copy this file to `.env` and fill in real values for production.

# SQLite for local dev. For production use PostgreSQL:
#   DATABASE_URL="postgresql://user:pass@host:5432/myspot"
DATABASE_URL="file:./dev.db"

# Used to sign/derive session tokens. Use a long random string in production:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Payment provider: "sandbox" | "stripe" | "razorpay"
# sandbox  = simulated gateway, no real money (default for dev/demo)
# stripe   = real Stripe (requires STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET)
# razorpay = real Razorpay (requires RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET)
PAYMENT_PROVIDER="sandbox"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Maps provider: "osm" (default, keyless OpenStreetMap tiles) | "mapbox"
MAP_PROVIDER="osm"
MAPBOX_TOKEN=""

# Email / SMS (optional; falls back to console logs in dev)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMS_PROVIDER=""
SMS_API_KEY=""

NEXT_PUBLIC_APP_NAME="MYSPOT"
