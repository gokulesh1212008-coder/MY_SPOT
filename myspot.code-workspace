{
  "folders": [{ "path": "." }],
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "bradlc.vscode-tailwindcss",
      "prisma.prisma",
      "vitest.explorer",
      "ms-vscode.vscode-typescript-next",
      "mikestead.dotenv",
      "eamodio.gitlens"
    ],
    "unwantedRecommendations": ["ms-vscode.js-debug"]
  },
  "settings": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
    "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "typescript.tsdk": "node_modules/typescript/lib",
    "tailwindCSS.experimental.classRegex": [["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]],
    "files.exclude": { ".next": true, "node_modules": true },
    "search.exclude": { ".next": true, "node_modules": true, "coverage": true },
    "files.associations": { ".env": "dotenv", ".env.example": "dotenv" },
    "terminal.integrated.defaultProfile.windows": "Git Bash"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run Next.js dev server",
        "type": "shell",
        "command": "npm run dev -- -p 3000",
        "isBackground": true,
        "problemMatcher": ["$tsc-watch"],
        "presentation": { "reveal": "always", "panel": "new" },
        "group": { "kind": "build", "isDefault": true }
      },
      {
        "label": "Build (production)",
        "type": "shell",
        "command": "npm run build",
        "problemMatcher": ["$tsc"],
        "group": "build"
      },
      {
        "label": "Typecheck",
        "type": "shell",
        "command": "npm run typecheck",
        "problemMatcher": ["$tsc"],
        "group": "build"
      },
      {
        "label": "Lint",
        "type": "shell",
        "command": "npm run lint",
        "problemMatcher": ["$eslint-stylish"],
        "group": "build"
      },
      {
        "label": "Run unit tests",
        "type": "shell",
        "command": "npm test",
        "problemMatcher": ["$tsc"],
        "group": "test"
      },
      {
        "label": "Run end-to-end smoke test (needs server on :3000)",
        "type": "shell",
        "command": "bash scripts/smoke-test.sh",
        "problemMatcher": []
      },
      {
        "label": "DB: generate Prisma client",
        "type": "shell",
        "command": "npm run db:generate",
        "problemMatcher": []
      },
      {
        "label": "DB: create/apply migration",
        "type": "shell",
        "command": "npm run db:migrate",
        "problemMatcher": []
      },
      {
        "label": "DB: seed demo data",
        "type": "shell",
        "command": "npm run db:seed",
        "problemMatcher": []
      },
      {
        "label": "DB: reset + reseed (destructive)",
        "type": "shell",
        "command": "npm run db:reset",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Next.js: debug client-side",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder}"
      },
      {
        "name": "Next.js: debug server-side",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev -- -p 3000"
      },
      {
        "name": "Next.js: debug full stack",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev -- -p 3000",
        "serverReadyAction": {
          "pattern": "Local: .*(https?:\\/\\/[^:]+(:\\d+)?)",
          "uriFormat": "%s",
          "action": "debugWithChrome"
        }
      },
      {
        "name": "Vitest: debug current file",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
        "args": ["run", "${relativeFile}"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "autoAttachChildProcesses": true
      }
    ]
  }
}
